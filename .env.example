# ==========================================
# STUDYPILOT AI — ENVIRONMENT CONFIGURATION
# ==========================================

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API
# Get your free/pro API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_MODEL=gemini-1.5-flash

# Supabase Database & Auth
# Get your credentials from https://app.supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Code Execution Sandbox (e.g. Judge0 or Piston API)
# When omitted, StudyPilot AI uses the built-in Intelligent Explanation & Simulation Lab.
JUDGE0_API_KEY=
JUDGE0_API_HOST=https://judge0-ce.p.rapidapi.com

# Optional: Stripe Monetization (Disabled by default until credentials are set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
